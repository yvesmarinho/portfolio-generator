{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yves.eti.br/schemas/portfolio-v1.json",
  "title": "Portfolio Generator — Output Schema v1",
  "description": "Schema para catálogo automatizado de projetos profissionais gerado pelo portfolio-gen",
  "type": "object",
  "required": [
    "generated_at",
    "generator_version",
    "scan_path",
    "total_projects",
    "skipped_projects",
    "scan_duration_seconds",
    "projects"
  ],
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO-8601 de geração do catálogo",
      "examples": ["2026-06-17T10:30:00Z"]
    },
    "generator_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Versão semântica do portfolio-gen",
      "examples": ["1.0.0"]
    },
    "scan_path": {
      "type": "string",
      "description": "Caminho raiz escaneado",
      "examples": ["/home/yves_marinho/Documentos/DevOps/"]
    },
    "total_projects": {
      "type": "integer",
      "minimum": 0,
      "description": "Total de projetos catalogados com sucesso"
    },
    "skipped_projects": {
      "type": "integer",
      "minimum": 0,
      "description": "Total de projetos pulados por erro durante o scan"
    },
    "scan_duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Duração total do scan em segundos"
    },
    "projects": {
      "type": "array",
      "description": "Lista de entradas de projetos catalogados",
      "items": {
        "$ref": "#/definitions/project"
      }
    }
  },
  "definitions": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "path",
        "type",
        "description",
        "description_source",
        "language",
        "metrics",
        "git",
        "technologies",
        "status",
        "last_modified"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Nome do diretório do projeto",
          "examples": ["portfolio-generator"]
        },
        "path": {
          "type": "string",
          "description": "Caminho relativo ao scan_path (sem / inicial)",
          "pattern": "^[^/]",
          "examples": ["Projetos/portfolio-generator"]
        },
        "type": {
          "type": "string",
          "description": "Tipo inferido do projeto",
          "enum": [
            "cli-tool",
            "web-app",
            "library",
            "api-service",
            "data-analysis",
            "infrastructure",
            "automation",
            "script",
            "documentation",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Resumo do projeto (vazio se description_source='empty')",
          "examples": ["CLI tool for automated project cataloging"]
        },
        "description_source": {
          "type": "string",
          "enum": ["readme", "ai-generated", "filename", "empty", "ai-unavailable"],
          "description": "Origem da descrição do projeto"
        },
        "language": {
          "type": "object",
          "required": ["primary", "secondary", "confidence"],
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string",
              "description": "Linguagem principal detectada ('unknown' se não detectada)",
              "examples": ["Python", "JavaScript", "unknown"]
            },
            "secondary": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Linguagens secundárias (pode ser vazia)",
              "examples": [["Bash", "YAML"]]
            },
            "confidence": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "description": "Confiança na detecção (0.0 quando primary='unknown')"
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["file_count", "size_bytes"],
          "additionalProperties": false,
          "properties": {
            "file_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Total de arquivos excluindo .git, node_modules, __pycache__, .venv"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Tamanho total em bytes (excluindo pastas ignoradas)"
            },
            "line_count_estimated": {
              "type": "integer",
              "minimum": 0,
              "description": "Estimativa de linhas de código (opcional)"
            }
          }
        },
        "git": {
          "type": "object",
          "required": ["initialized"],
          "additionalProperties": false,
          "properties": {
            "initialized": {
              "type": "boolean",
              "description": "Se o projeto tem git inicializado"
            },
            "branch": {
              "type": "string",
              "description": "Branch atual (presente apenas se git.initialized=true)"
            },
            "last_commit_hash": {
              "type": "string",
              "description": "Hash curto do último commit (7 chars)"
            },
            "last_commit_date": {
              "type": "string",
              "format": "date-time",
              "description": "Data/hora do último commit (ISO-8601)"
            },
            "last_commit_author": {
              "type": "string",
              "description": "Autor do último commit"
            },
            "commit_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Total de commits"
            }
          }
        },
        "technologies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tecnologias/frameworks detectados no projeto",
          "examples": [["click", "pandas", "docker"]]
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived", "unknown"],
          "description": "Status inferido do projeto"
        },
        "last_modified": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora da última modificação do projeto (ISO-8601)"
        }
      }
    }
  }
}
