      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(make *)",
      "Bash(pytest *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(systemctl *)",
      "Bash(journalctl *)",
      "Bash(ufw *)",
      "Bash(bash *)",
      "Bash(sh *)"
